# ---------------------------------------------------------------------------
# Neon Postgres (Serverless Driver ueber HTTP)
# Connection String aus dem Neon Dashboard -> "Pooled connection"
#
# WICHTIG: hier gehoert der "dev"-Branch hinein, nicht der Produktions-Branch.
# Die Produktions-URL wird ausschliesslich als Worker-Secret gesetzt:
#   pnpm exec wrangler secret put DATABASE_URL
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Better Auth
# Secret erzeugen:  openssl rand -base64 32
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Resend (transaktionale E-Mails)
#
# Ohne verifizierte Domain laesst Resend nur "onboarding@resend.dev" als
# Absender zu - und Zustellung ausschliesslich an die Adresse, mit der der
# Resend-Account registriert ist. Fuer die Entwicklung reicht das:
#   RESEND_FROM="Wartung <onboarding@resend.dev>"
#   MAINTENANCE_NOTIFY_EMAIL="<eigene Resend-Account-Adresse>"
#
# Mails an Kunden (sendServiceReportEmail) brauchen eine verifizierte Domain.
# Der Free Tier deckt 3 Domains und 100 Mails/Tag ab.
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM="Wartung <onboarding@resend.dev>"
# Empfaenger der Wartungs-Benachrichtigungen im Buero
MAINTENANCE_NOTIFY_EMAIL="buero@example.de"

# ---------------------------------------------------------------------------
# Cron
# Schuetzt /api/cron/maintenance gegen Aufrufe von aussen.
# ---------------------------------------------------------------------------
CRON_SECRET=""
